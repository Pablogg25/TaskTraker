{
  "name": "tasktracker-desktop",
  "version": "1.0.0",
  "description": "TasksTracker - registro personal de tareas y horas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.pablogonzalez.tasktracker",
    "productName": "TasksTracker",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
